<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>أبلغ عن غرض - منصة المفقودات</title>
    <link rel="stylesheet" href="style.css">
</head>
<body>

    <!-- شريط التنقل -->
    <header class="navbar">
        <div class="logo">🔍 أثر (المفقودات)</div>
        <nav>
            <ul>
                <li><a href="index.html">الرئيسية</a></li>
                <li><a href="items.html">الأغراض</a></li>
                <li><a href="report.html" class="active">أبلغ عن غرض</a></li>
                <li><a href="contact.html">تواصل معنا</a></li>
            </ul>
        </nav>
    </header>

    <!-- نموذج الإبلاغ -->
    <main class="container">
        <section class="form-section">
            <h2>نموذج الإبلاغ عن غرض جديد</h2>
            <p>املأ البيانات بدقة لمساعدتنا في إيجاد صاحب الغرض أو الغرض المفقود</p>
            
            <form class="custom-form">
                <div class="form-group">
                    <label>نوع البلاغ:</label>
                    <select>
                        <option value="lost">أبحث عن مفقود (ضائع مني)</option>
                        <option value="found">وجدت غرضاً (أريد تسليمه لصاحبه)</option>
                    </select>
                </div>

                <div class="form-group">
                    <label>اسم الغرض:</label>
                    <input type="text" placeholder="مثال: هاتف محمول، حقيبة، محفظة...">
                </div>

                <div class="form-group">
                    <label>المكان الذي فقد أو وجد فيه:</label>
                    <input type="text" placeholder="حدد اسم المكان بدقة">
                </div>

                <div class="form-group">
                    <label>التاريخ:</label>
                    <input type="date">
                </div>

                <div class="form-group">
                    <label>وصف مختصر ورقم التواصل:</label>
                    <textarea rows="4" placeholder="اكتب تفاصيل إضافية ورقم الهاتف للتواصل..."></textarea>
                </div>

                <button type="submit" class="submit-btn">إرسال البلاغ الآن</button>
            </form>
        </section>
    </main>

    <!-- التذييل -->
    <footer>
        <p>جميع الحقوق محفوظة &copy; 2026 - منصة المفقودات والموجودات</p>
    </footer>

</body>
</html>
